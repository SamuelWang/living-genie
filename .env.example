# Consumed by `docker compose` for the postgres service (Compose auto-loads .env from the
# project root). Must match the credentials embedded in web-api/.env's DATABASE_URL.
POSTGRES_USER=living_genie
POSTGRES_PASSWORD=living_genie
POSTGRES_DB=living_genie

# Grafana's admin login (http://localhost:3000). Change these if the host is reachable by others.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
